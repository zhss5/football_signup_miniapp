<view class="team-list">
  <block wx:for="{{teams}}" wx:key="_id">
    <view class="team-card">
      <view class="team-head">
        <view class="team-title-row">
          <button
            wx:if="{{item.canEditColor}}"
            class="team-kit-button"
            data-team-id="{{item._id}}"
            bindtap="onTeamColorTap"
          >
            <view class="team-kit-icon {{item.teamColorClass}}">
              <view class="team-kit-sleeve team-kit-sleeve-left"></view>
              <view class="team-kit-body"></view>
              <view class="team-kit-sleeve team-kit-sleeve-right"></view>
            </view>
          </button>
          <view wx:else class="team-kit-button">
            <view class="team-kit-icon {{item.teamColorClass}}">
              <view class="team-kit-sleeve team-kit-sleeve-left"></view>
              <view class="team-kit-body"></view>
              <view class="team-kit-sleeve team-kit-sleeve-right"></view>
            </view>
          </view>
          <text
            wx:if="{{item.canEditColor}}"
            class="team-name {{item.teamColorClass}}-text"
            data-team-id="{{item._id}}"
            bindtap="onTeamColorTap"
          >{{item.teamName}}</text>
          <text wx:else class="team-name {{item.teamColorClass}}-text">{{item.teamName}}</text>
          <button
            wx:if="{{item.canProxySignup}}"
            class="proxy-signup-button"
            data-team-id="{{item._id}}"
            data-team-name="{{item.teamName}}"
            bindtap="onProxySignupTap"
          >{{item.proxySignupText}}</button>
          <button
            wx:if="{{item.joinActionVisible}}"
            class="join-button"
            data-team-id="{{item._id}}"
            bindtap="onJoinTap"
          >{{item.joinActionText}}</button>
        </view>
        <text class="team-count">{{item.joinedCount}} / {{item.maxMembers}}</text>
      </view>
      <view wx:if="{{item.members.length}}" class="member-list">
        <block wx:for="{{item.members}}" wx:key="userOpenId" wx:for-item="member">
          <view class="member-row">
            <view
              class="member-profile"
              hover-class="member-profile-hover"
              data-user-open-id="{{member.userOpenId}}"
              data-signup-name="{{member.signupName}}"
              data-avatar-url="{{member.avatarUrl}}"
              data-avatar-text="{{member.avatarText}}"
              data-manager-alias="{{member.managerAliasText}}"
              data-manager-alias-editable="{{member.managerAliasActionVisible}}"
              bindtap="onMemberTap"
            >
              <image wx:if="{{member.avatarUrl}}" class="member-avatar-image" src="{{member.avatarUrl}}" mode="aspectFill" />
              <view
                wx:else
                class="member-avatar-fallback {{item.teamColorClass}} {{item.teamColorRequiresBorder ? 'member-avatar-fallback-bordered' : ''}}"
              >{{member.avatarText}}</view>
              <view class="member-info">
                <view class="member-name-row">
                  <text class="member-name">{{member.signupName}}</text>
                  <text wx:if="{{member.proxyBadgeVisible}}" class="member-proxy-badge">{{member.proxyBadgeText}}</text>
                  <text
                    wx:if="{{member.attendanceStatusVisible}}"
                    class="member-attendance-status {{member.attendanceStatus === 'absent' ? 'member-attendance-absent' : 'member-attendance-present'}}"
                  >{{member.attendanceStatusText}}</text>
                </view>
                <text wx:if="{{member.preferredPositionsVisible}}" class="member-position-text">{{member.preferredPositionsText}}</text>
                <text wx:if="{{member.managerAliasVisible}}" class="member-manager-alias">{{member.managerAliasText}}</text>
              </view>
            </view>
            <button
              wx:if="{{member.attendanceActionVisible}}"
              class="member-action-button member-action-attendance {{member.attendanceActionStatus === 'present' ? 'member-action-present' : 'member-action-absent'}}"
              size="mini"
              data-action="attendance"
              data-registration-id="{{member.registrationId}}"
              data-attendance-status="{{member.attendanceActionStatus}}"
              data-user-open-id="{{member.userOpenId}}"
              data-signup-name="{{member.signupName}}"
              catchtap="onMemberActionTap"
            >{{member.attendanceActionText}}</button>
            <button
              wx:if="{{member.moveActionVisible}}"
              class="member-action-button member-action-move"
              size="mini"
              data-action="move"
              data-user-open-id="{{member.userOpenId}}"
              data-signup-name="{{member.signupName}}"
              data-current-team-id="{{item._id}}"
              catchtap="onMemberActionTap"
            >{{member.moveActionText}}</button>
            <button
              wx:if="{{member.memberAction}}"
              class="member-action-button {{member.memberAction === 'cancelSignup' ? 'member-action-cancel' : ''}} {{member.memberAction === 'remove' ? 'member-action-danger' : ''}}"
              size="mini"
              data-action="{{member.memberAction}}"
              data-user-open-id="{{member.userOpenId}}"
              data-signup-name="{{member.signupName}}"
              catchtap="onMemberActionTap"
            >{{member.memberActionText}}</button>
          </view>
        </block>
      </view>
      <text wx:else class="empty-members">{{emptyText}}</text>
    </view>
  </block>
</view>
