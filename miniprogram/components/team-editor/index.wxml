<view class="team-editor">
  <block wx:for="{{teams}}" wx:key="index">
    <view class="team-row">
      <view class="team-fields">
        <button
          class="team-color-chip team-color-{{item.colorKey || 'green'}}"
          data-index="{{index}}"
          data-field="colorKey"
          bindtap="onTeamColorTap"
        ></button>
        <input
          class="team-input"
          value="{{item.teamName}}"
          data-index="{{index}}"
          data-field="teamName"
          bindinput="onTeamFieldInput"
        />
        <input
          class="team-input team-capacity"
          type="number"
          value="{{item.maxMembers}}"
          data-index="{{index}}"
          data-field="maxMembers"
          bindinput="onTeamFieldInput"
        />
        <button wx:if="{{teams.length > 1}}" class="remove-button" data-index="{{index}}" bindtap="onRemoveTeam">{{labels.remove || 'Remove'}}</button>
      </view>
    </view>
  </block>
  <button wx:if="{{teams.length < 4}}" class="add-button" bindtap="onAddTeam">{{labels.addTeam || 'Add Team'}}</button>

  <view wx:if="{{paletteVisible}}" class="color-palette-backdrop" catchtap="onPaletteCancel">
    <view class="color-palette-panel" catchtap="noop">
      <text class="color-palette-title">{{labels.colorPaletteTitle || 'Team color'}}</text>
      <view class="color-palette-grid">
        <button
          wx:for="{{paletteOptions}}"
          wx:key="key"
          class="color-palette-option"
          data-color-key="{{item.key}}"
          bindtap="onPaletteColorTap"
        >
          <view class="team-color-chip {{item.className}}"></view>
          <text class="color-palette-label">{{item.label}}</text>
        </button>
      </view>
    </view>
  </view>
</view>
