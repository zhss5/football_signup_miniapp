@import "../../styles/team-kit.wxss";

.team-row {
  margin-bottom: 16rpx;
}

.team-fields {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
}

.team-input {
  flex: 1 1 auto;
  min-width: 0;
  box-sizing: border-box;
  display: block;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 18rpx;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 2rpx solid #eef0ef;
}

.team-capacity {
  flex: 0 0 116rpx;
  text-align: center;
}

.remove-button {
  flex: 0 0 auto;
  margin: 0;
  height: 64rpx;
  line-height: 60rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #b91c1c;
  border: 2rpx solid #fecaca;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.remove-button::after {
  border: 0;
}

.add-button {
  margin-top: 12rpx;
  height: 80rpx;
  line-height: 76rpx;
  background: #ffffff;
  color: #15803d;
  border: 2rpx dashed #bcd0c4;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.add-button::after {
  border: 0;
}

.color-palette-backdrop {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.36);
}

.color-palette-panel {
  width: 100%;
  max-width: 640rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
}

.color-palette-title {
  display: block;
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.color-palette-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.color-palette-option {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
  color: #111827;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: left;
}

.color-palette-option::after {
  border: none;
}

.color-palette-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
