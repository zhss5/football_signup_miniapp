<view class="card {{embedded ? 'card-embedded' : ''}}" bindtap="onTap">
  <view wx:if="{{activeCoverImage || item.coverImage}}" class="cover-frame">
    <image
      wx:if="{{activeCoverImage && !coverLoadFailed}}"
      class="cover-image"
      src="{{activeCoverImage}}"
      mode="aspectFill"
      lazy-load="{{true}}"
      binderror="onCoverError"
    />
    <view wx:else class="cover-placeholder"></view>
  </view>
  <view class="activity-card-title-row">
    <text class="title">{{item.title}}</text>
    <text class="status status-{{item.statusTone}}">{{item.statusText}}</text>
  </view>
  <view wx:if="{{item.startDisplayText}}" class="activity-card-meta-row">
    <text class="meta-icon">◷</text>
    <text class="meta">{{item.startPrefixText}}</text>
  </view>
  <view class="activity-card-meta-row">
    <text class="meta-icon">⌖</text>
    <text class="meta">{{item.addressText}}</text>
  </view>
  <view class="activity-card-meta-row">
    <text class="meta-icon">♙</text>
    <text class="meta capacity-text">{{item.capacityText}}</text>
  </view>
  <view wx:if="{{item.activityTags && item.activityTags.length}}" class="activity-card-tags">
    <block wx:for="{{item.activityTags}}" wx:for-item="tag" wx:key="key">
      <text class="tag tag-{{tag.tone}}">{{tag.label}}</text>
    </block>
  </view>
</view>
