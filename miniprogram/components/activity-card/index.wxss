  background-image: url("data:image/svg+xml;base64,");
}

.meta {
  min-width: 0;
  color: #64748b;
  font-size: 25rpx;
  line-height: 34rpx;
}

.capacity-text {
  color: #475569;
}

.status {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

.status-joinable {
  background: #dcfce7;
  color: #168a45;
}

.status-disabled {
  background: #f3f4f6;
  color: #9ca3af;
}

.status-expired {
  background: #fee2e2;
  color: #b91c1c;
}

.activity-card-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #edf2f7;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  background: #f8fafc;
  color: #64748b;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 44rpx;
}

.tag-type {
  background: #eef2f7;
  color: #475569;
}

.tag-confirmed {
  background: #ecfdf3;
  color: #15803d;
}

.tag-pending {
  background: #fff7ed;
  color: #c2410c;
}

.tag-deadline {
  background: #f8fafc;
  color: #64748b;
}
