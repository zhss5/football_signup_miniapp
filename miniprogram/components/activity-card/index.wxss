.card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.card-embedded {
  margin-bottom: 0;
  border-radius: 0;
}

.cover-frame {
  position: relative;
  width: 100%;
  padding-top: 80%;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
  background: #f3f4f6;
}

.cover-image,
.cover-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #30412d 0%, #395636 100%);
}

.card-embedded .cover-frame {
  padding-top: 40%;
}

.activity-card-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.title {
  min-width: 0;
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #111827;
}

.activity-card-meta-row {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  min-height: 34rpx;
}

.meta-icon {
  flex: 0 0 30rpx;
  width: 30rpx;
  height: 34rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 28rpx 28rpx;
}

