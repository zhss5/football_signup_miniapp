.card {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.card-embedded {
  margin-bottom: 0;
  border-radius: 0;
}

.cover-frame {
  position: relative;
  width: 100%;
  padding-top: 80%;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
  background: #f3f4f6;
}

.cover-image,
.cover-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
}

.title {
  font-size: 30rpx;
  font-weight: 700;
}

.meta {
  color: #6b7280;
}

.activity-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 2rpx;
}

.capacity-text {
  min-width: 0;
  flex: 1;
}

.status {
  flex: 0 0 auto;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.3;
  white-space: nowrap;
}

.status-joinable {
  background: #dcfce7;
  color: #168a45;
}

.status-disabled {
  background: #f3f4f6;
  color: #9ca3af;
}

.status-expired {
  background: #fee2e2;
  color: #b91c1c;
}
