@import "../../styles/team-kit.wxss";

.page {
  padding: 24rpx;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

.hero {
  position: relative;
  width: 100%;
  max-width: 100%;
  margin-bottom: 24rpx;
}

.hero-banner {
  position: relative;
  width: 100%;
  padding-top: 62%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #30412d;
}

.cover-image,
.cover-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-placeholder {
  background: linear-gradient(135deg, #30412d 0%, #395636 100%);
}

.hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 64rpx 28rpx 22rpx;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0));
}

.hero-title {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 700;
}

.hero-status {
  flex: 0 0 auto;
}

.hero-info-card {
  position: relative;
  margin: -28rpx 16rpx 0;
  padding: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.08);
}

.share-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.share-card-highlight {
  border: 2rpx solid #16a34a;
  box-shadow: 0 8rpx 24rpx rgba(22, 163, 74, 0.12);
}

.insurance-link-button {
  display: block;
  width: auto;
  margin: 0 0 18rpx;
  padding: 0;
  background: transparent;
  color: #0f766e;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: left;
}

.insurance-link-button::after {
  border: 0;
}

.share-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.share-copy {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.share-button {
  margin-top: 16rpx;
  background: #16a34a;
  color: #ffffff;
}

.description-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.detail-images-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.description-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.description-copy {
  display: block;
  margin-top: 12rpx;
  color: #374151;
  font-size: 28rpx;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.detail-images-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.detail-image {
  display: block;
  width: 100%;
  background: #f3f4f6;
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.activity-time-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
  margin-top: 0;
  color: #374151;
  font-size: 28rpx;
}

.activity-time-label {
  color: #111827;
  font-weight: 700;
}

.activity-time-value {
  min-width: 0;
  word-break: break-word;
}

.meta {
  display: block;
  margin-top: 12rpx;
  color: #6b7280;
}

.location-row {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
  align-items: stretch;
  max-width: 100%;
  overflow: hidden;
}

.location {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
  padding: 4rpx 0;
}

.location-text {
  flex: 1;
  min-width: 0;
}

.hero-info-icon {
  flex: 0 0 auto;
  width: 32rpx;
  height: 32rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 30rpx 30rpx;
}

.hero-info-icon-time {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjMTU4MDNkJyBzdHJva2Utd2lkdGg9JzInIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcgc3Ryb2tlLWxpbmVqb2luPSdyb3VuZCc+PGNpcmNsZSBjeD0nMTInIGN5PScxMicgcj0nOScvPjxwYXRoIGQ9J00xMiA3djVsMyAyJy8+PC9zdmc+");
}

.hero-info-icon-place {
  margin-top: 2rpx;
  background-image: url("data:image/svg+xml;base64,");
}

.location-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  word-break: break-word;
}

.location-map-wrap {
  position: relative;
  flex: 0 0 168rpx;
  display: block;
  width: 168rpx;
  max-width: 168rpx;
  height: 112rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  overflow: hidden;
}

.location-map {
  width: 100%;
  height: 100%;
  max-width: 100%;
}

.location-map-hitarea {
  position: absolute;
  left: 0;
  top: 0;
  width: 168rpx;
  max-width: 168rpx;
  height: 112rpx;
  box-sizing: border-box;
}

.hero-status-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.confirmed-banner,
.cancelled-banner,
.signup-closed-banner {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.confirmed-banner {
  background: #dcfce7;
  color: #166534;
}

.cancelled-banner {
  background: #fee2e2;
  color: #991b1b;
}

.signup-closed-banner {
  background: #f3f4f6;
  color: #4b5563;
}

.expired-stamp {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 244rpx;
  height: 94rpx;
  box-sizing: border-box;
  border: 6rpx solid #dc2626;
  border-radius: 18rpx;
  background: rgba(254, 242, 242, 0.82);
  color: #dc2626;
  font-size: 42rpx;
  font-weight: 900;
  line-height: 1;
  transform: rotate(-12deg);
  transform-origin: center;
  box-shadow: inset 0 0 0 3rpx rgba(220, 38, 38, 0.18),
    0 6rpx 18rpx rgba(220, 38, 38, 0.14);
  pointer-events: none;
}

.action-panel {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.action-panel-title {
  grid-column: 1 / -1;
  color: #9ca3af;
  font-size: 24rpx;
  font-weight: 600;
}

.action-button {
  width: 100%;
  margin: 0;
  color: #374151;
  background: #f7faf8;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
}

.confirm-action-button,
.danger-action-button {
  grid-column: 1 / -1;
}

.action-button::after {
  border: 0;
}

.action-button-disabled,
.action-button[disabled] {
  color: #9ca3af;
  background: #f3f4f6;
  border-color: #e5e7eb;
}

.danger-action-button {
  color: #b91c1c;
  background: #ffffff;
  border-color: #fecaca;
}

.confirm-action-button {
  color: #ffffff;
  background: #16a34a;
  border-color: #16a34a;
}

.color-palette-backdrop {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.36);
}

.color-palette-panel {
  width: 100%;
  max-width: 640rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
}

.color-palette-title {
  display: block;
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.color-palette-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.color-palette-option {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  height: 72rpx;
  margin: 0;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 16rpx;
  background: #ffffff;
  color: #111827;
  font-size: 24rpx;
  line-height: 72rpx;
  text-align: left;
}

.color-palette-option::after {
  border: none;
}

.color-palette-label {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.proxy-signup-backdrop {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.36);
}

.proxy-signup-panel {
  width: 100%;
  max-width: 640rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
}

.proxy-signup-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.proxy-signup-team {
  display: block;
  margin-top: 6rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.proxy-signup-field {
  margin-top: 24rpx;
}

.proxy-signup-label {
  display: block;
  margin-bottom: 10rpx;
  color: #374151;
  font-size: 24rpx;
  font-weight: 600;
}

.proxy-signup-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f9fafb;
}

.proxy-signup-hint {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
}

.proxy-position-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.proxy-position-option {
  flex: 0 0 auto;
  min-width: 124rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 1rpx solid transparent;
  border-radius: 32rpx;
  color: #374151;
  background: #f9fafb;
  font-size: 24rpx;
}

.proxy-position-option::after,
.proxy-signup-cancel::after,
.proxy-signup-confirm::after {
  border: none;
}

.proxy-position-option-selected {
  color: #166534;
  background: #dcfce7;
  border-color: #bbf7d0;
  font-weight: 700;
}

.proxy-signup-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.proxy-signup-cancel,
.proxy-signup-confirm {
  flex: 1;
  margin: 0;
  border-radius: 20rpx;
}

.proxy-signup-cancel {
  color: #374151;
  background: #f3f4f6;
}

.proxy-signup-confirm {
  color: #ffffff;
  background: #16a34a;
}

.participant-dialog-backdrop {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(17, 24, 39, 0.36);
}

.participant-dialog-panel {
  width: 100%;
  max-width: 640rpx;
  padding: 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
}

.participant-dialog-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.participant-dialog-profile {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
}

.participant-dialog-avatar-image,
.participant-dialog-avatar-fallback {
  flex: 0 0 auto;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
}

.participant-dialog-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #dcfce7;
  color: #166534;
  font-size: 36rpx;
  font-weight: 700;
}

.participant-dialog-name {
  min-width: 0;
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.participant-dialog-field {
  margin-top: 26rpx;
}

.participant-dialog-label {
  display: block;
  margin-bottom: 10rpx;
  color: #374151;
  font-size: 24rpx;
  font-weight: 600;
}

.participant-dialog-input {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f9fafb;
}

.participant-dialog-attendance {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 26rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #f9fafb;
}

.participant-dialog-attendance-status {
  min-width: 0;
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
}

.participant-dialog-attendance-button {
  flex: 0 0 auto;
  min-width: 180rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.participant-dialog-attendance-absent {
  color: #dc2626;
  background: #fee2e2;
}

.participant-dialog-attendance-present {
  color: #166534;
  background: #dcfce7;
}

.participant-dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.participant-dialog-cancel,
.participant-dialog-save {
  flex: 1;
  margin: 0;
  border-radius: 20rpx;
}

.participant-dialog-cancel {
  color: #374151;
  background: #f3f4f6;
}

.participant-dialog-save {
  color: #ffffff;
  background: #16a34a;
}

.participant-dialog-cancel::after,
.participant-dialog-save::after,
.participant-dialog-attendance-button::after {
  border: none;
}
