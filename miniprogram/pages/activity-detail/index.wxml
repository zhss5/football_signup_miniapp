<view class="page" wx:if="{{activity}}">
  <view class="hero">
    <view wx:if="{{activityCoverImage || activity.coverImage}}" class="cover-frame">
      <image
        wx:if="{{activityCoverImage && !activityCoverLoadFailed}}"
        class="cover-image"
        src="{{activityCoverImage}}"
        mode="aspectFill"
        bindtap="onPreviewActivityCover"
        binderror="onActivityCoverError"
      />
      <view wx:else class="cover-placeholder"></view>
    </view>
    <text class="title">{{activity.title}}</text>
    <view wx:if="{{activityTimeText}}" class="activity-time-row">
      <text class="activity-time-label">{{i18n.activity.timeLabel}}</text>
      <text class="activity-time-value">{{activityTimeText}}</text>
    </view>
    <view class="location-row">
      <view class="location" bindtap="onOpenLocation">
        <text class="location-name">{{activity.addressName || activity.addressText}}</text>
        <text wx:if="{{activity.addressName && activity.addressName !== activity.addressText}}" class="meta">{{activity.addressText}}</text>
      </view>
      <view wx:if="{{locationMapVisible}}" class="location-map-wrap">
        <map
          class="location-map"
          latitude="{{activity.location.latitude}}"
          longitude="{{activity.location.longitude}}"
          markers="{{locationMapMarkers}}"
          scale="15"
          enable-scroll="{{false}}"
          enable-zoom="{{false}}"
          enable-rotate="{{false}}"
          show-location="{{false}}"
          bindmarkertap="onOpenLocation"
          bindtap="onOpenLocation"
        >
          <cover-view class="location-map-hitarea" bindtap="onOpenLocation"></cover-view>
        </map>
      </view>
    </view>
    <view wx:if="{{activity.status === 'published' && activity.confirmStatus === 'confirmed'}}" class="hero-status-row">
      <view wx:if="{{activity.status === 'published' && activity.confirmStatus === 'confirmed'}}" class="confirmed-banner">
        <text>{{i18n.activity.status.confirmed}}</text>
      </view>
    </view>
    <view wx:if="{{activity.status === 'cancelled'}}" class="hero-status-row">
      <view class="cancelled-banner">
        <text>{{i18n.activity.status.cancelled}}</text>
      </view>
    </view>
    <view wx:if="{{activitySignupClosedVisible}}" class="hero-status-row">
      <view class="signup-closed-banner">
        <text>{{i18n.activity.status.signupClosed}}</text>
      </view>
    </view>
    <view wx:if="{{activityExpiredVisible}}" class="expired-stamp">
      <text>{{i18n.activity.status.expired}}</text>
    </view>
  </view>

  <view wx:if="{{activity.status === 'published'}}" class="share-card {{shareHintVisible ? 'share-card-highlight' : ''}}">
    <button wx:if="{{activity.insuranceLink}}" class="insurance-link-button" bindtap="onOpenInsuranceLink">
      {{i18n.activity.insurance.copyAction}}
    </button>
    <text class="share-title">{{shareHintVisible ? i18n.activity.share.publishedTitle : i18n.activity.share.defaultTitle}}</text>
    <text class="share-copy">{{shareHintVisible ? i18n.activity.share.publishedCopy : i18n.activity.share.defaultCopy}}</text>
    <button class="share-button" open-type="share">{{i18n.activity.share.action}}</button>
  </view>

  <team-list
    teams="{{teams}}"
    emptyText="{{i18n.activity.teamList.empty}}"
    bind:jointap="openSignup"
    bind:proxysignup="onProxySignup"
    bind:teamcolortap="onTeamColorTap"
    bind:movemember="onMoveRegistration"
    bind:removemember="onRemoveRegistration"
    bind:cancelsignup="onCancelSignup"
    bind:membertap="onMemberTap"
  />

  <view wx:if="{{activityDescriptionText}}" class="description-card">
    <text class="description-title">{{i18n.activity.descriptionTitle}}</text>
    <text class="description-copy">{{activityDescriptionText}}</text>
  </view>

  <view wx:if="{{activityDetailImages.length}}" class="detail-images-card">
    <text class="description-title">{{i18n.activity.activityImagesTitle}}</text>
    <view class="detail-images-list">
      <image
        wx:for="{{activityDetailImages}}"
        wx:key="*this"
        class="detail-image"
        src="{{item}}"
        mode="widthFix"
        data-index="{{index}}"
        bindtap="onPreviewDetailImage"
      />
    </view>
  </view>

  <view wx:if="{{colorPaletteVisible}}" class="color-palette-backdrop" catchtap="onColorPaletteCancel">
    <view class="color-palette-panel" catchtap="noop">
      <text class="color-palette-title">{{i18n.activity.teamColorTitle || 'Team color'}}</text>
      <view class="color-palette-grid">
        <button
          wx:for="{{colorPaletteOptions}}"
          wx:key="key"
          class="color-palette-option"
          data-color-key="{{item.key}}"
          bindtap="onColorPaletteSelect"
        >
          <view class="team-kit-icon {{item.className}}">
            <view class="team-kit-sleeve team-kit-sleeve-left"></view>
            <view class="team-kit-body"></view>
            <view class="team-kit-sleeve team-kit-sleeve-right"></view>
          </view>
          <text class="color-palette-label">{{item.label}}</text>
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{proxySignupVisible}}" class="proxy-signup-backdrop" catchtap="onProxySignupCancel">
    <view class="proxy-signup-panel" catchtap="noop">
      <text class="proxy-signup-title">{{i18n.modal.proxySignup.title}}</text>
      <text wx:if="{{proxySignupTeamName}}" class="proxy-signup-team">{{proxySignupTeamName}}</text>

      <view class="proxy-signup-field">
        <text class="proxy-signup-label">{{i18n.modal.proxySignup.placeholder}}</text>
        <input
          class="proxy-signup-input"
          placeholder="{{i18n.modal.proxySignup.placeholder}}"
          value="{{proxySignupName}}"
          bindinput="onProxySignupNameInput"
        />
      </view>

      <view class="proxy-signup-field">
        <text class="proxy-signup-label">{{i18n.activityJoin.preferredPositions}}</text>
        <text class="proxy-signup-hint">{{i18n.activityJoin.preferredPositionsHint}}</text>
        <view class="proxy-position-grid">
          <button
            wx:for="{{proxySignupPositionOptions}}"
            wx:key="value"
            class="proxy-position-option {{item.selected ? 'proxy-position-option-selected' : ''}}"
            data-value="{{item.value}}"
            bindtap="onProxySignupPositionTap"
          >{{item.label}}</button>
        </view>
      </view>

      <view class="proxy-signup-actions">
        <button class="proxy-signup-cancel" bindtap="onProxySignupCancel">
          {{i18n.modal.proxySignup.cancel}}
        </button>
        <button
          class="proxy-signup-confirm"
          loading="{{proxySignupSubmitting}}"
          bindtap="onProxySignupSubmit"
        >
          {{i18n.activityJoin.confirm}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{participantDialogVisible}}" class="participant-dialog-backdrop" catchtap="onParticipantDialogCancel">
    <view class="participant-dialog-panel" catchtap="noop">
      <text class="participant-dialog-title">{{i18n.modal.participant.title}}</text>
      <view class="participant-dialog-profile">
        <image
          wx:if="{{participantDialogMember.avatarUrl}}"
          class="participant-dialog-avatar-image"
          src="{{participantDialogMember.avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="participant-dialog-avatar-fallback">
          {{participantDialogMember.avatarText}}
        </view>
        <text class="participant-dialog-name">{{participantDialogMember.signupName}}</text>
      </view>

      <view wx:if="{{participantDialogAliasEditable}}" class="participant-dialog-field">
        <text class="participant-dialog-label">{{i18n.modal.participant.aliasLabel}}</text>
        <input
          class="participant-dialog-input"
          value="{{participantDialogAlias}}"
          placeholder="{{i18n.modal.managerAlias.placeholder}}"
          bindinput="onParticipantAliasInput"
        />
      </view>

      <view wx:if="{{participantDialogAttendanceVisible}}" class="participant-dialog-attendance">
        <text class="participant-dialog-attendance-status">{{participantDialogAttendanceStatusText}}</text>
        <button
          class="participant-dialog-attendance-button {{participantDialogAttendanceActionStatus === 'present' ? 'participant-dialog-attendance-present' : 'participant-dialog-attendance-absent'}}"
          loading="{{participantDialogAttendanceSaving}}"
          bindtap="onParticipantAttendanceChange"
        >
          {{participantDialogAttendanceActionText}}
        </button>
      </view>

      <view class="participant-dialog-actions">
        <button class="participant-dialog-cancel" bindtap="onParticipantDialogCancel">
          {{participantDialogAliasEditable ? i18n.modal.participant.cancel : i18n.modal.participant.close}}
        </button>
        <button
          wx:if="{{participantDialogAliasEditable}}"
          class="participant-dialog-save"
          loading="{{participantDialogSaving}}"
          bindtap="onParticipantAliasSave"
        >
          {{i18n.modal.participant.save}}
        </button>
      </view>
    </view>
  </view>

  <view wx:if="{{viewer && (viewer.canManageRegistrations || viewer.canEditActivity || viewer.canCancelActivity)}}" class="action-panel">
    <button wx:if="{{viewer.canManageRegistrations}}" class="action-button" bindtap="onCopyParticipantNames">
      {{i18n.activity.actions.copyParticipantNames}}
    </button>

    <button
      wx:if="{{viewer.canManageRegistrations}}"
      class="action-button {{viewer.registrationNotificationSubscribed ? 'action-button-disabled' : ''}}"
      disabled="{{viewer.registrationNotificationSubscribed}}"
      bindtap="onSubscribeRegistrationNotifications"
    >
      {{viewer.registrationNotificationSubscribed ? i18n.activity.actions.registrationNotificationsSubscribed : i18n.activity.actions.subscribeRegistrationNotifications}}
    </button>

        <button wx:if="{{viewer.canEditActivity}}" class="action-button" bindtap="openEditActivity">
          {{i18n.activity.actions.edit}}
        </button>

        <button wx:if="{{viewer.canEditActivity}}" class="action-button" bindtap="onCopyActivity">
          {{i18n.activity.actions.copyActivity}}
        </button>

        <button
          wx:if="{{viewer.canEditActivity && activity.status === 'published' && activity.confirmStatus !== 'confirmed'}}"
      class="action-button confirm-action-button"
      bindtap="onConfirmActivityProceeding"
    >
      {{i18n.activity.actions.confirmProceeding}}
    </button>

    <button wx:if="{{viewer.canCancelActivity}}" class="action-button danger-action-button" bindtap="onCancelActivity">
      {{i18n.activity.actions.cancelActivity}}
    </button>
  </view>

</view>
