<view class="page">
  <view class="top-toolbar">
    <view class="utility-pill-row">
      <button
        size="mini"
        class="utility-pill language-toolbar-button"
        data-locale="{{nextLocale}}"
        bindtap="onLanguageChange"
      >
        <text class="utility-pill-icon">◎</text>
        <text>{{currentLanguageLabel}}</text>
      </button>
      <button
        wx:if="{{canConfirmWebAdminLogin}}"
        size="mini"
        class="utility-pill web-admin-login-link"
        bindtap="onConfirmWebAdminLogin"
      >
        <text class="utility-pill-icon">▦</text>
        <text>{{i18n.my.webAdminToolbarAction}}</text>
      </button>
    </view>
  </view>

  <view wx:if="{{showCreatedActivitiesTab}}" class="primary-tab-shell">
    <block wx:for="{{tabs}}" wx:key="key">
      <button
        size="mini"
        class="primary-tab-chip {{activeTab === item.key ? 'primary-tab-chip-active' : ''}}"
        data-tab-key="{{item.key}}"
        bindtap="onTabChange"
      >
        {{item.label}}
      </button>
    </block>
  </view>

  <view wx:if="{{showCreatedActivitiesTab && activeTab === 'created'}}" class="section">
    <view class="created-filter-shell">
      <button
        size="mini"
        class="filter-trigger {{createdFilterDropdownVisible ? 'filter-trigger-open' : ''}}"
        bindtap="onCreatedFilterToggle"
      >
        <text class="filter-trigger-icon">▽</text>
        <text class="filter-trigger-text">{{currentCreatedFilterLabel}}</text>
        <text class="filter-trigger-caret">⌄</text>
      </button>
      <view wx:if="{{createdFilterDropdownVisible}}" class="filter-menu">
        <block wx:for="{{createdFilterOptions}}" wx:key="key">
          <button
            size="mini"
            class="filter-menu-item {{item.selected ? 'filter-menu-item-active' : ''}}"
            data-filter-key="{{item.key}}"
            bindtap="onCreatedFilterSelect"
          >
            <text class="filter-menu-label">{{item.label}}</text>
            <text class="filter-menu-count">{{item.count}}</text>
            <text wx:if="{{item.selected}}" class="filter-menu-check">✓</text>
          </button>
        </block>
      </view>
    </view>
    <block wx:for="{{createdItems}}" wx:key="_id">
      <view class="created-activity-card">
        <activity-card item="{{item}}" embedded="{{true}}" bind:tapcard="goDetail" />
        <view wx:if="{{item.canDeleteActivity}}" class="activity-action-footer">
          <button
            wx:if="{{item.canDeleteActivity}}"
            size="mini"
            class="activity-action-button"
            data-activity-id="{{item._id}}"
            catchtap="onDeleteActivity"
          >
            {{i18n.activity.actions.delete}}
          </button>
        </view>
      </view>
    </block>
    <view wx:if="{{createdHasMore || createdLoadingMore}}" class="pagination-row">
      <button
        wx:if="{{createdHasMore && !createdLoadingMore}}"
        size="mini"
        class="load-more-button"
        data-scope="created"
        bindtap="loadMoreMyActivities"
      >
        {{i18n.my.loadMore}}
      </button>
      <text wx:if="{{createdLoadingMore}}" class="loading-more-text">{{i18n.my.loadingMore}}</text>
    </view>
  </view>

  <view wx:else class="section">
    <block wx:for="{{joinedItems}}" wx:key="_id">
      <activity-card item="{{item}}" bind:tapcard="goDetail" />
    </block>
    <view wx:if="{{joinedHasMore || joinedLoadingMore}}" class="pagination-row">
      <button
        wx:if="{{joinedHasMore && !joinedLoadingMore}}"
        size="mini"
        class="load-more-button"
        data-scope="joined"
        bindtap="loadMoreMyActivities"
      >
        {{i18n.my.loadMore}}
      </button>
      <text wx:if="{{joinedLoadingMore}}" class="loading-more-text">{{i18n.my.loadingMore}}</text>
    </view>
  </view>
</view>
