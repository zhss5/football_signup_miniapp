<view class="page">
  <view class="top-tools-card">
    <view class="utility-row">
      <text class="utility-label">{{i18n.my.languageLabel}}</text>
      <view class="language-switch-track">
        <block wx:for="{{languageOptions}}" wx:key="key">
          <button
            size="mini"
            class="utility-chip {{locale === item.key ? 'utility-chip-active' : ''}}"
            data-locale="{{item.key}}"
            bindtap="onLanguageChange"
          >
            {{item.label}}
          </button>
        </block>
      </view>
    </view>

    <view wx:if="{{canConfirmWebAdminLogin}}" class="web-admin-login-card">
      <view class="web-admin-login-icon">Web</view>
      <view class="web-admin-login-copy">
        <text class="web-admin-login-title">{{i18n.my.webAdminLoginTitle}}</text>
        <text class="web-admin-login-hint">{{i18n.my.webAdminLoginHint}}</text>
      </view>
      <button
        size="mini"
        class="web-admin-login-button"
        bindtap="onConfirmWebAdminLogin"
      >
        {{i18n.my.webAdminLoginAction}}
      </button>
    </view>
  </view>

  <view class="primary-tab-shell">
    <block wx:for="{{tabs}}" wx:key="key">
      <button
        size="mini"
        class="primary-tab-chip {{activeTab === item.key ? 'primary-tab-chip-active' : ''}}"
        data-tab-key="{{item.key}}"
        bindtap="onTabChange"
      >
        {{item.label}}
      </button>
    </block>
  </view>

  <view wx:if="{{activeTab === 'created'}}" class="section">
    <view class="filter-group">
      <text class="filter-heading">{{filterLabel}}</text>
      <view class="filter-row">
        <block wx:for="{{createdFilters}}" wx:key="key">
          <button
            size="mini"
            class="filter-chip {{createdFilter === item.key ? 'filter-chip-active' : ''}}"
            data-filter-key="{{item.key}}"
            bindtap="onCreatedFilterTap"
          >
            {{item.label}}
          </button>
        </block>
      </view>
    </view>
    <block wx:for="{{createdItems}}" wx:key="_id">
      <view class="created-activity-card">
        <activity-card item="{{item}}" embedded="{{true}}" bind:tapcard="goDetail" />
        <view wx:if="{{item.canDeleteActivity}}" class="activity-action-footer">
          <button
            wx:if="{{item.canDeleteActivity}}"
            size="mini"
            class="activity-action-button"
            data-activity-id="{{item._id}}"
            catchtap="onDeleteActivity"
          >
            {{i18n.activity.actions.delete}}
          </button>
        </view>
      </view>
    </block>
    <view wx:if="{{createdHasMore || createdLoadingMore}}" class="pagination-row">
      <button
        wx:if="{{createdHasMore && !createdLoadingMore}}"
        size="mini"
        class="load-more-button"
        data-scope="created"
        bindtap="loadMoreMyActivities"
      >
        {{i18n.my.loadMore}}
      </button>
      <text wx:if="{{createdLoadingMore}}" class="loading-more-text">{{i18n.my.loadingMore}}</text>
    </view>
  </view>

  <view wx:elif="{{activeTab === 'joined'}}" class="section">
    <block wx:for="{{joinedItems}}" wx:key="_id">
      <activity-card item="{{item}}" bind:tapcard="goDetail" />
    </block>
    <view wx:if="{{joinedHasMore || joinedLoadingMore}}" class="pagination-row">
      <button
        wx:if="{{joinedHasMore && !joinedLoadingMore}}"
        size="mini"
        class="load-more-button"
        data-scope="joined"
        bindtap="loadMoreMyActivities"
      >
        {{i18n.my.loadMore}}
      </button>
      <text wx:if="{{joinedLoadingMore}}" class="loading-more-text">{{i18n.my.loadingMore}}</text>
    </view>
  </view>
</view>
