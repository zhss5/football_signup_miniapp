.page {
  padding: 24rpx;
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
}

.top-toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 48rpx;
  margin-bottom: 20rpx;
  color: #4b5563;
  font-size: 24rpx;
}

.utility-row {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  gap: 8rpx;
}

.utility-label {
  display: inline-flex;
  align-items: center;
  color: #6b7280;
  font-size: 24rpx;
}

.language-toolbar-button,
.web-admin-login-link {
  min-width: 0;
  min-height: 48rpx;
  padding: 0;
  background: transparent;
  color: #172033;
  border: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 48rpx;
}

.language-toolbar-button {
  color: #1d4ed8;
}

.language-toolbar-button::after,
.web-admin-login-link::after,
.primary-tab-chip::after,
.filter-chip::after,
.activity-action-button::after,
.load-more-button::after {
  border: 0;
}

.toolbar-divider {
  width: 2rpx;
  height: 24rpx;
  flex: 0 0 2rpx;
  background: #d1d5db;
}

.web-admin-login-link-wrap {
  display: flex;
  min-width: 0;
  flex: 0 1 auto;
}

.web-admin-login-link {
  color: #172033;
}

.identity-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.identity-label,
.identity-role {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
}

.identity-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 10rpx 0;
}

.identity-value {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 24rpx;
  word-break: break-all;
}

.primary-tab-shell {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8rpx;
  padding: 8rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.primary-tab-chip {
  min-width: 0;
  min-height: 68rpx;
  background: transparent;
  color: #4b5563;
  border: 0;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.primary-tab-chip-active {
  background: #0f172a;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(17, 24, 39, 0.18);
}

.section {
  margin-bottom: 32rpx;
}

.filter-group {
  margin-bottom: 24rpx;
}

.filter-heading {
  display: block;
  margin-bottom: 12rpx;
  color: #6b7280;
  font-size: 22rpx;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  min-width: 120rpx;
  background: #ffffff;
  color: #4b5563;
  border: 2rpx solid #e5e7eb;
}

.filter-chip-active {
  background: #f3f4f6;
  color: #111827;
  border-color: #9ca3af;
}

.created-activity-card {
  margin-bottom: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 24rpx;
}

.activity-action-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 18rpx 24rpx 24rpx;
  border-top: 2rpx solid #f3f4f6;
}

.activity-action-button {
  min-width: 180rpx;
  background: #ffffff;
  color: #374151;
  border: 2rpx solid #e5e7eb;
}

.pagination-row {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}

.load-more-button {
  min-width: 220rpx;
  background: #ffffff;
  color: #374151;
  border: 2rpx solid #d1d5db;
}

.loading-more-text {
  color: #6b7280;
  font-size: 24rpx;
}
