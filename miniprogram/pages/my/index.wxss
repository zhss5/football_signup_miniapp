.page {
  min-height: 100vh;
  padding: 0 24rpx;
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
  background: #f4f7f5;
}

.top-toolbar {
  display: flex;
  justify-content: flex-end;
  padding: 24rpx 0 26rpx;
}

.utility-pill-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.utility-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 0;
  min-height: 56rpx;
  padding: 0 18rpx;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #172033;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 56rpx;
  box-shadow: 0 8rpx 22rpx rgba(15, 23, 42, 0.06);
}

.utility-pill-icon {
  display: inline-block;
  vertical-align: middle;
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 30rpx 30rpx;
}

.utility-pill-icon-globe {
  background-image: url("data:image/svg+xml;base64,");
}

.utility-pill-icon-qr {
  background-image: url("data:image/svg+xml;base64,");
}

.language-toolbar-button {
  color: #172033;
}

.web-admin-login-link {
  background: #e9fff2;
  color: #14783d;
}

.language-toolbar-button::after,
.web-admin-login-link::after,
.primary-tab-chip::after,
.filter-trigger::after,
.filter-menu-item::after,
.activity-action-button::after,
.load-more-button::after {
  border: 0;
}

.identity-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.identity-label,
.identity-role {
  display: block;
  color: #6b7280;
  font-size: 22rpx;
}

.identity-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 10rpx 0;
}

.identity-value {
  flex: 1;
  min-width: 0;
  color: #111827;
  font-size: 24rpx;
  word-break: break-all;
}

.primary-tab-shell {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0;
  width: 100%;
  height: 82rpx;
  padding: 8rpx;
  margin: 0 0 28rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: #eef4f1;
}

.primary-tab-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  height: 66rpx;
  min-height: 66rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  background: transparent;
  color: #4b5563;
  border: 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1;
  text-align: center;
}

.primary-tab-chip-active {
  background: #16833c;
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(22, 131, 60, 0.2);
}

.section {
  position: relative;
  margin-bottom: 32rpx;
}

.created-filter-shell {
  position: relative;
  z-index: 5;
  margin-bottom: 22rpx;
}

.filter-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-width: 160rpx;
  min-height: 58rpx;
  padding: 0 18rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #14532d;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.06);
}

.filter-trigger-open {
  background: #f0fdf4;
  border-color: #16a34a;
}

.filter-trigger-icon,
.filter-trigger-caret {
  display: inline-block;
  vertical-align: middle;
  background-repeat: no-repeat;
  background-position: center;
}

.filter-trigger-icon {
  width: 28rpx;
  height: 28rpx;
  margin-right: 6rpx;
  background-size: 26rpx 26rpx;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjMTZhMzRhJyBzdHJva2Utd2lkdGg9JzInIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcgc3Ryb2tlLWxpbmVqb2luPSdyb3VuZCc+PHBhdGggZD0nTTMgNWgxOGwtNyA4djVsLTQgMnYtN3onLz48L3N2Zz4=");
}

.filter-trigger-caret {
  width: 24rpx;
  height: 24rpx;
  margin-left: 6rpx;
  background-size: 22rpx 22rpx;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0naHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmcnIHZpZXdCb3g9JzAgMCAyNCAyNCcgZmlsbD0nbm9uZScgc3Ryb2tlPScjNjQ3NDhiJyBzdHJva2Utd2lkdGg9JzInIHN0cm9rZS1saW5lY2FwPSdyb3VuZCcgc3Ryb2tlLWxpbmVqb2luPSdyb3VuZCc+PHBhdGggZD0nTTYgOWw2IDYgNi02Jy8+PC9zdmc+");
}

.filter-trigger-text {
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-menu {
  position: absolute;
  top: 72rpx;
  left: 0;
  width: 248rpx;
  padding: 10rpx 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 18rpx 42rpx rgba(15, 23, 42, 0.16);
}

.filter-menu-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #ffffff;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 76rpx;
  text-align: left;
}

.filter-menu-item-hover {
  background: #f4f7f5;
}

.filter-menu-item-active {
  background: #eefaf2;
  color: #16833c;
}

.filter-menu-label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-menu-count {
  flex: 0 0 auto;
  margin-left: 12rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.filter-menu-check {
  flex: 0 0 auto;
  width: 30rpx;
  height: 30rpx;
  margin-left: 12rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 28rpx 28rpx;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMTY4MzNjIiBzdHJva2Utd2lkdGg9IjIuNSIgc3Ryb2tlLWxpbmVjYXA9InJvdW5kIiBzdHJva2UtbGluZWpvaW49InJvdW5kIj48cGF0aCBkPSJNNSAxMmw1IDUgOS0xMCIvPjwvc3ZnPg==");
}

.created-activity-card {
  margin-bottom: 26rpx;
  overflow: hidden;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 30rpx rgba(15, 23, 42, 0.08);
}

.activity-action-footer {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding: 18rpx 24rpx 24rpx;
  border-top: 2rpx solid #edf2f7;
}

.activity-action-button {
  min-width: 136rpx;
  min-height: 54rpx;
  margin: 0 0 0 auto;
  padding: 0 20rpx;
  background: #ffffff;
  color: #dc2626;
  border: 2rpx solid #fecaca;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 54rpx;
}

.pagination-row {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}

.load-more-button {
  min-width: 220rpx;
  min-height: 58rpx;
  background: #ffffff;
  color: #374151;
  border: 2rpx solid #d1d5db;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 58rpx;
}

.loading-more-text {
  color: #6b7280;
  font-size: 24rpx;
}
