.page {
  padding: 24rpx;
}

.field {
  margin-bottom: 24rpx;
}

.authorization-panel {
  padding: 32rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.authorization-title {
  display: block;
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
}

.sub-label {
  display: block;
  margin-bottom: 10rpx;
  color: #6b7280;
  font-size: 22rpx;
}

.input,
.textarea,
.picker-input {
  width: 100%;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f9fafb;
  border: 2rpx solid #eef0ef;
}

.input,
.picker-input {
  display: block;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 20rpx;
}

.input-error {
  border: 2rpx solid #dc2626;
}

.textarea {
  min-height: 500rpx;
  padding: 20rpx;
  line-height: 1.5;
}

.picker-row {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  background: #f9fafb;
  border: 2rpx solid #eef0ef;
  border-radius: 16rpx;
}

.picker-row-label {
  flex: 1;
  min-width: 0;
  color: #374151;
  font-size: 28rpx;
  font-weight: 600;
}

.picker-row-value {
  color: #111827;
  font-size: 28rpx;
}

.picker-row-caret {
  flex: 0 0 auto;
  width: 28rpx;
  height: 28rpx;
  margin-left: 10rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 24rpx 24rpx;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjYzBjNWNjIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTkgNmw2IDYtNiA2Ii8+PC9zdmc+");
}

.picker-grid {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-cell {
  flex: 1;
}

.hint {
  display: block;
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  color: #dc2626;
  font-size: 24rpx;
}

.activity-type-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8rpx;
  padding: 8rpx;
  border-radius: 16rpx;
  background: #eef1f0;
}

.activity-type-radio {
  display: none;
}

.activity-type-option {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 68rpx;
  border-radius: 12rpx;
  background: transparent;
  color: #4b5563;
  font-size: 26rpx;
  font-weight: 600;
}

.activity-type-option-active {
  background: #15803d;
  color: #ffffff;
}

.notification-settings-group {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.section-card .field:last-child {
  margin-bottom: 0;
}

.notification-settings-header {
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f3f4f6;
}

.notification-settings-header .hint {
  margin-top: 0;
}

.notification-settings-field {
  margin-bottom: 24rpx;
}

.notification-settings-field:last-child {
  margin-bottom: 0;
}

.notification-settings-group .input {
  background: #f9fafb;
}

.upload-panel {
  padding: 0;
  background: transparent;
}

.image-preview-frame {
  position: relative;
  width: 100%;
  padding-top: 80%;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f3f4f6;
}

.image-preview-frame:active {
  opacity: 0.86;
}

.image-preview,
.upload-placeholder {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #f3faf5;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 72rpx 72rpx;
  background-image: url("data:image/svg+xml;base64,");
}

.secondary-button {
  margin-top: 16rpx;
  height: 80rpx;
  line-height: 76rpx;
  padding: 0 20rpx;
  background: #ffffff;
  color: #374151;
  border: 2rpx solid #e5e7eb;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.secondary-button::after {
  border: 0;
}

.sb-icon {
  display: inline-block;
  vertical-align: middle;
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 26rpx 26rpx;
}

.sb-icon-plus {
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjMzc0MTUxIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTEyIDV2MTRNNSAxMmgxNCIvPjwvc3ZnPg==");
}

.sb-icon-map {
  background-image: url("data:image/svg+xml;base64,");
}

.map-button {
  border-color: #cfe9da;
}

.ghost-button {
  margin-top: 12rpx;
  background: #f9fafb;
  color: #374151;
}

.detail-images-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.detail-image-cell {
  min-width: 0;
}

.detail-image-preview {
  display: block;
  width: 100%;
  height: 180rpx;
  background: #f3f4f6;
}

.detail-image-remove {
  margin-top: 8rpx;
  color: #b91c1c;
  background: #fef2f2;
  font-size: 24rpx;
}

.section-card {
  margin-bottom: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.section-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  flex: 0 0 auto;
  width: 36rpx;
  height: 36rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 34rpx 34rpx;
}

.section-icon-info {
  background-image: url("data:image/svg+xml;base64,");
}

.section-icon-calendar {
  background-image: url("data:image/svg+xml;base64,");
}

.section-icon-users {
  background-image: url("data:image/svg+xml;base64,");
}

.section-icon-photo {
  background-image: url("data:image/svg+xml;base64,");
}

.section-icon-pin {
  background-image: url("data:image/svg+xml;base64,");
}

.section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 700;
}

.map-button {
  color: #15803d;
  background: #e9f6ee;
}

.submit-button {
  margin-top: 8rpx;
  height: 92rpx;
  line-height: 92rpx;
  background: #15803d;
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.submit-button::after {
  border: 0;
}
