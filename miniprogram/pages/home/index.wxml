<view class="page">
  <button wx:if="{{canCreateActivity}}" class="primary-button" bindtap="goCreate">{{i18n.home.createActivity}}</button>

  <view class="list">
    <block wx:for="{{items}}" wx:key="_id">
      <activity-card item="{{item}}" bind:tapcard="goDetail" />
    </block>
  </view>

  <view wx:if="{{emptyVisible}}" class="empty-state">
    <text class="empty-title">{{i18n.home.emptyTitle}}</text>
    <text class="empty-copy">{{i18n.home.emptyCopy}}</text>
  </view>
</view>
