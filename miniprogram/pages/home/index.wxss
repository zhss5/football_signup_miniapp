.page {
  padding: 24rpx;
  padding-bottom: calc(144rpx + env(safe-area-inset-bottom));
}

.list {
  margin-top: 24rpx;
}

.primary-button {
  height: 92rpx;
  line-height: 92rpx;
  background: #15803d;
  color: #ffffff;
  border-radius: 18rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.primary-button::after {
  border: 0;
}

.primary-button-icon {
  display: inline-block;
  vertical-align: middle;
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 30rpx 30rpx;
  background-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCIgZmlsbD0ibm9uZSIgc3Ryb2tlPSIjZmZmZmZmIiBzdHJva2Utd2lkdGg9IjIiIHN0cm9rZS1saW5lY2FwPSJyb3VuZCIgc3Ryb2tlLWxpbmVqb2luPSJyb3VuZCI+PHBhdGggZD0iTTEyIDV2MTRNNSAxMmgxNCIvPjwvc3ZnPg==");
}

.empty-state {
  min-height: 720rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx 140rpx;
  color: #8a94a6;
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 120rpx 120rpx;
  background-image: url("data:image/svg+xml;base64,");
}

.empty-title {
  color: #2f3542;
  font-size: 34rpx;
  font-weight: 700;
}

.empty-copy {
  margin-top: 16rpx;
  font-size: 26rpx;
}

.pagination-row {
  display: flex;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}

.load-more-button {
  min-width: 240rpx;
  height: 68rpx;
  line-height: 64rpx;
  color: #374151;
  background: #ffffff;
  border: 2rpx solid #d1d5db;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.load-more-button::after {
  border: 0;
}

.loading-more-text {
  color: #6b7280;
  font-size: 24rpx;
}
